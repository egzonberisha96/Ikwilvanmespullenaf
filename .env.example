# ============================================================================
# ikwilvanmespullenaf.nl — Environment variables
# Kopieer dit bestand naar .env en vul de waarden in.
# ============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://ikwilvanmespullenaf:ikwilvanmespullenaf@localhost:5432/ikwilvanmespullenaf"

# --- App / NextAuth -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Genereer met: openssl rand -base64 32
NEXTAUTH_SECRET="vervang-dit-met-een-willekeurige-string"

# --- Uploadthing (foto uploads) ------------------------------------------------
# Aanmaken op https://uploadthing.com
UPLOADTHING_TOKEN=""

# --- E-mail (SMTP via Nodemailer) ----------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="IkWilVanMeSpullenAf <noreply@ikwilvanmespullenaf.nl>"

# --- Mollie (betalingen) --------------------------------------------------------
# Test API key vind je op https://my.mollie.com
MOLLIE_API_KEY="test_vervang-dit"

# --- Postgres (voor docker-compose) ---------------------------------------------
POSTGRES_USER="ikwilvanmespullenaf"
POSTGRES_PASSWORD="ikwilvanmespullenaf"
POSTGRES_DB="ikwilvanmespullenaf"
